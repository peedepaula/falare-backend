  "components": {
    "schemas": {
      "AtualizarAlunoRequest": {
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 150,
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "maxLength": 255,
            "type": [
              "null",
              "string"
            ]
          },
          "senha": {
            "minLength": 6,
            "type": [
              "null",
              "string"
            ]
          },
          "telefone": {
            "maxLength": 30,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AtualizarMatriculaRequest": {
        "type": "object",
        "properties": {
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StatusMatricula"
              }
            ]
          },
          "p1": {
            "maximum": 10,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "p2": {
            "maximum": 10,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "trabalho": {
            "maximum": 10,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "AtualizarPagamentoRequest": {
        "type": "object",
        "properties": {
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StatusPagamento"
              }
            ]
          },
          "valor": {
            "maximum": 1000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "AtualizarProfessorRequest": {
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 150,
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "maxLength": 255,
            "type": [
              "null",
              "string"
            ]
          },
          "senha": {
            "minLength": 6,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AtualizarTurmasRequest": {
        "type": "object",
        "properties": {
          "idioma": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Idioma"
              }
            ]
          },
          "nivel": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Nivel"
              }
            ]
          },
          "dias": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "horario": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "professorId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "vagas": {
            "maximum": 1000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CadastrarAlunoRequest": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 150,
            "type": "string"
          },
          "email": {
            "maxLength": 255,
            "type": [
              "null",
              "string"
            ]
          },
          "senha": {
            "minLength": 6,
            "type": [
              "null",
              "string"
            ]
          },
          "telefone": {
            "maxLength": 30,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CadastrarAulaRequest": {
        "required": [
          "turmaId",
          "data"
        ],
        "type": "object",
        "properties": {
          "turmaId": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CadastrarMatriculaRequest": {
        "required": [
          "alunoId",
          "turmaId"
        ],
        "type": "object",
        "properties": {
          "alunoId": {
            "type": "string",
            "format": "uuid"
          },
          "turmaId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CadastrarPagamentoRequest": {
        "required": [
          "alunoId"
        ],
        "type": "object",
        "properties": {
          "alunoId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/StatusPagamento"
          },
          "valor": {
            "maximum": 1000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CadastrarProfessorRequest": {
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 150,
            "type": "string"
          },
          "email": {
            "maxLength": 255,
            "type": "string"
          },
          "senha": {
            "minLength": 6,
            "type": "string"
          }
        }
      },
      "CadastrarTurmasRequest": {
        "required": [
          "dias",
          "horario",
          "professorId"
        ],
        "type": "object",
        "properties": {
          "idioma": {
            "$ref": "#/components/schemas/Idioma"
          },
          "nivel": {
            "$ref": "#/components/schemas/Nivel"
          },
          "dias": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "horario": {
            "type": "string",
            "format": "time"
          },
          "professorId": {
            "type": "string",
            "format": "uuid"
          },
          "vagas": {
            "maximum": 1000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Idioma": {
        "type": "integer"
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          },
          "tipoUsuario": {
            "$ref": "#/components/schemas/TipoLogin"
          }
        }
      },
      "Nivel": {
        "type": "integer"
      },
      "StatusMatricula": {
        "type": "integer"
      },
      "StatusPagamento": {
        "type": "integer"
      },
      "TipoLogin": {
        "type": "integer"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Cole apenas o token (sem a palavra Bearer)",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
